<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/speech_setting_bg"
    android:padding="24dp"
    android:gravity="center">

    <!-- 마이크 아이콘 -->
    <ImageView
        android:id="@+id/icon_mic"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/mike"
        android:layout_marginBottom="32dp"
        android:layout_gravity="center" />

    <!-- 안내 카드 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/setting_bg"
        android:padding="20dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="신고 음성을 안내에 따라 말씀해주세요."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/report_icon"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/text_target_wake_word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="신고"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/report_icon"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/text_remaining_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="남은 횟수 : 5"
            android:textColor="#4CAF50"
            android:textSize="16sp"
            android:layout_gravity="center" />

    </LinearLayout>

    <!-- 음성 인식 상태 -->
    <TextView
        android:id="@+id/text_recognition_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="&lt; 음성 인식 중입니다 &gt;"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="32dp"
        android:layout_gravity="center" />

    <!-- 그만하기 버튼 -->
    <Button
        android:id="@+id/btn_stop_recognition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="그만 하기"
        android:textColor="#FFFFFF"
        android:background="@drawable/announcement_bg"
        android:layout_marginBottom="16dp" />

</LinearLayout>
