<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 메인 UI -->
    <LinearLayout
        android:id="@+id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#000000">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. 신고 음성 변경 하기 섹션 -->
                <LinearLayout
                    android:id="@+id/voice_change_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/speech_setting_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/btn_change_wake_word"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="신고 음성 변경 하기"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:background="@drawable/announcement_bg"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="현재 신고 음성"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="center"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/report_icon"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/text_current_wake_word"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="신고"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/report_icon"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&lt; 최대 세 글자까지 변경 할 수 있습니다. &gt;"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp"
                        android:layout_gravity="center" />

                </LinearLayout>

                <!-- 2. 신고 음성 인식률 높이기 섹션 -->
                <LinearLayout
                    android:id="@+id/voice_improve_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/speech_setting_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/btn_improve_recognition"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="신고 음성 인식률 높이기"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:background="@drawable/announcement_bg"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="음성을 반복해서 말해 인식률을 높입니다."
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="최대한 조용한 환경에서 진행해주세요."
                        android:textColor="#FF6B6B"
                        android:textSize="14sp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&lt; 신고 음성을 변경하면 초기화 됩니다. &gt;"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp"
                        android:layout_gravity="center" />

                </LinearLayout>

                <!-- 3. 음성 감지 세팅 자동 조절 섹션 -->
                <LinearLayout
                    android:id="@+id/auto_adjust_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/speech_setting_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/btn_auto_adjust"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="음성 감지 세팅 자동 조절 하기"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:background="@drawable/announcement_bg"
                        android:layout_marginBottom="16dp" />

                    <!-- 마이크 민감도 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/setting_bg"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="마이크 민감도"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:gravity="center_vertical" />

                        <SeekBar
                            android:id="@+id/seekbar_mic_sensitivity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:max="5000"
                            android:progress="3500"
                            android:background="@drawable/sound_bg"
                            android:thumb="@drawable/toggle_button" />

                        <TextView
                            android:id="@+id/text_mic_sensitivity_display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:layout_marginStart="8dp"
                            android:gravity="center_vertical" />

                    </LinearLayout>

                    <!-- 작은 소리 감지 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/setting_bg"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="작은 소리 감지"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:gravity="center_vertical" />

                        <SeekBar
                            android:id="@+id/seekbar_small_sound"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:max="5000"
                            android:progress="3500"
                            android:background="@drawable/sound_bg"
                            android:thumb="@drawable/toggle_button" />

                        <TextView
                            android:id="@+id/text_small_sound_display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:layout_marginStart="8dp"
                            android:gravity="center_vertical" />

                    </LinearLayout>

                    <!-- 큰 소리 감지 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/setting_bg"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="큰 소리 감지"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:gravity="center_vertical" />

                        <SeekBar
                            android:id="@+id/seekbar_large_sound"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:max="5000"
                            android:progress="3500"
                            android:background="@drawable/sound_bg"
                            android:thumb="@drawable/toggle_button" />

                        <TextView
                            android:id="@+id/text_large_sound_display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:layout_marginStart="8dp"
                            android:gravity="center_vertical" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- 하단 네비게이션 바 -->
        <com.example.hanbangreportnative.BottomNavBar
            android:id="@+id/bottom_nav_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#000000" />

    </LinearLayout>

    <!-- 팝업 컨테이너 -->
    <FrameLayout
        android:id="@+id/popup_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#80000000"
        android:gravity="center">
        
        <!-- 팝업이 여기에 동적으로 추가됩니다 -->
        
    </FrameLayout>

</FrameLayout>
